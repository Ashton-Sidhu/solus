# Optional analytics. Leave unset to disable PostHog capture.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional Google Docs/Drive integration.
# Google desktop OAuth clients require both values at build time.
SOLUS_GOOGLE_CLIENT_ID=
SOLUS_GOOGLE_CLIENT_SECRET=

# Optional GitHub integration (PR review).
# OAuth App device flow needs only the client ID — no secret is shipped.
SOLUS_GITHUB_CLIENT_ID=

# Confluence/Jira browser sign-in — the only way Solus connects to Atlassian.
# Atlassian has no public-client mode, so the secret is required on token
# exchange even with PKCE. Leave both unset and the connection is unavailable.
# Register the app's callback as exactly:
#   http://127.0.0.1:51789/oauth/atlassian/callback
SOLUS_ATLASSIAN_CLIENT_ID=
SOLUS_ATLASSIAN_CLIENT_SECRET=

# Required only when producing signed/notarized macOS release builds.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
