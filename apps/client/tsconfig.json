{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@solus/contracts/*": ["../../packages/contracts/src/*"],
      "@solus/client-core/*": ["../../packages/client-core/src/*"],
      "@solus/workspace-ui/*": ["../../packages/workspace-ui/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
