  "comments": {
    "ACME-214": [
      {
        "id": "demo-task-comment-1",
        "author": {
          "login": "maya-platform"
        },
        "body": "Please keep the reset value in whole seconds; two customer SDKs currently parse it as an integer.",
        "createdAt": "2026-07-13T14:10:00.000Z"
      },
      {
        "id": "demo-task-comment-2",
        "author": {
          "login": "agent"
        },
        "body": "Rounding up in the middleware rather than at the edge, so a 1.2s reset serialises as `2` everywhere. Added a case to `rateLimit.test.ts` that asserts it.",
        "createdAt": "2026-07-13T15:02:00.000Z"
      },
      {
        "id": "demo-task-comment-3",
        "author": {
          "login": "acme-dev"
        },
        "body": "Done. `RateLimit-Reset` and `Retry-After` both round up, and the middleware test covers a 1.2 second reset as `2`.",
        "createdAt": "2026-07-14T09:25:00.000Z"
      },
      {
        "id": "demo-task-comment-4",
        "author": {
          "login": "agent"
        },
        "body": "Shadow mode has been on for 24h: 0.4% of keys would have been limited, none of them customer-facing. Wrote the numbers up in the rollout notes and opened #142.",
        "createdAt": "2026-07-14T16:40:00.000Z"
      }
    ]
  },
