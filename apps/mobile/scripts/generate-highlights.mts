// Adapted from T3 Code apps/mobile/scripts/generate-highlights.mts (MIT, see apps/mobile/UPSTREAM.md).
/**
 * Regenerates the native @pierre/highlights build and its JavaScript tables.
 *
 * Hermes has no WebAssembly, so wasm2c turns the package's highlights.wasm
 * into C that `modules/solus-highlights` compiles. Token IDs and language IDs
 * are that build's ABI, so the language and theme tables come from the same
 * package: the copy at the repository root, which web uses. The output is
 * committed; a native build only compiles it. Run after bumping
 * @pierre/highlights, with the pinned tools:
 *
 *   WASM2C=<wabt-1.0.42>/bin/wasm2c SIMDE=<simde-amalgamated-0.8.2> \
 *     node apps/mobile/scripts/generate-highlights.mts
 *
 * wabt: https://github.com/WebAssembly/wabt/releases/tag/1.0.42
 * simde: simde-amalgamated-0.8.2.tar.xz from
 * https://github.com/simd-everywhere/simde/releases/tag/v0.8.2
 *
 * Node, not Bun: the identifier tables come from the engine's Unicode data,
 * and the script requires Unicode 17.0 (Node 25 has it; Bun 1.3 has 15.1).
 */
import { execFileSync } from "node:child_process";
import { createHash } from "node:crypto";
import { copyFileSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { tmpdir } from "node:os";
import { dirname, isAbsolute, join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import type { Theme } from "@pierre/highlights";

const WASM2C_VERSION = "1.0.42";
// The commit of simde's v0.8.2 tag, which the amalgamated header names.
const SIMDE_COMMIT = "71fd833d9666141edcd1d3c109a80e228303d8d7";
const UNICODE_VERSION = "17.0";
// The themes web colors diffs and files with (`getDiffThemeName` in
// packages/workspace-ui/src/lib/diff-worker-pool.ts).
const THEMES = { light: "github-light-default", dark: "github-dark-default" } as const;

const mobileRoot = resolve(import.meta.dirname, "..");
const repositoryRoot = resolve(mobileRoot, "../..");
const moduleRoot = join(mobileRoot, "modules/solus-highlights");
const generatedDataPath = join(mobileRoot, "src/lib/highlights.generated.ts");

interface ThemeStyle {
  readonly color?: string;
  readonly italic?: boolean;
  readonly weight?: number;
}

interface PreparedTheme {
  readonly fg: string;
  readonly styles: ReadonlyArray<ThemeStyle | null>;
}

interface HighlightsPackage {
  readonly root: string;
  readonly version: string;
  readonly wasmSha256: string;
}

export interface HighlightsData {
  readonly source: HighlightsPackage;
  readonly languageIds: Readonly<Record<string, number>>;
  readonly themeStyles: Readonly<Record<keyof typeof THEMES, ReadonlyArray<readonly [string, number]>>>;
}

interface Wasm2c {
  readonly binary: string;
  readonly prefix: string;
}

function resolveHighlightsPackage(): HighlightsPackage {
  const require = createRequire(join(repositoryRoot, "package.json"));
  const root = dirname(require.resolve("@pierre/highlights/package.json"));
  // SAFETY: an installed package's package.json names its version as a string.
  const { version } = JSON.parse(readFileSync(join(root, "package.json"), "utf8")) as { version: string };
  const wasm = readFileSync(join(root, "dist/highlights.wasm"));
  return { root, version, wasmSha256: createHash("sha256").update(wasm).digest("hex") };
}

function importDist<T>(root: string, file: string): Promise<T> {
  // The package exports neither its language table nor its theme resolver.
  // SAFETY: each caller names the exports of that dist file in the pinned package version.
  return import(pathToFileURL(join(root, "dist", file)).href) as Promise<T>;
}

export function generatedBanner(source: HighlightsPackage): string {
  return `Generated by apps/mobile/scripts/generate-highlights.mts from @pierre/highlights ${source.version} (highlights.wasm sha256 ${source.wasmSha256}). Do not edit.`;
}

export async function computeHighlightsData(): Promise<HighlightsData> {
  const source = resolveHighlightsPackage();
  const { default: languageIds } = await importDist<{ default: Record<string, number> }>(source.root, "languages.js");
  const { prepareTheme } = await importDist<{ prepareTheme: (theme: Theme) => PreparedTheme }>(source.root, "theme.js");

  const styleTable = async (name: string) => {
    const { default: theme } = await importDist<{ default: Theme }>(source.root, `themes/${name}.js`);
    const { fg, styles } = prepareTheme(theme);
    // Mirrors `lineRecordsToTokens`: unstyled tokens take the theme foreground.
    return styles.map((style, tokenId) => {
      const color = style?.color ?? fg;
      if (!/^#[0-9a-f]{6}([0-9a-f]{2})?$/iu.test(color)) {
        throw new Error(`${name} token ${tokenId} has a color React Native cannot draw: ${color}`);
      }
      const fontStyle = (style?.italic === true ? 1 : 0) | ((style?.weight ?? 0) >= 600 ? 2 : 0);
      return [color, fontStyle] as const;
    });
  };

  return {
    source,
    languageIds,
    themeStyles: { light: await styleTable(THEMES.light), dark: await styleTable(THEMES.dark) },
  };
}

export function renderHighlightsData(data: HighlightsData): string {
  const languages = Object.entries(data.languageIds).map(([name, id]) => `  ${JSON.stringify(name)}: ${id},`);
  const styles = (scheme: keyof typeof THEMES) =>
    data.themeStyles[scheme].map(([color, fontStyle]) => `    [${JSON.stringify(color)}, ${fontStyle}],`);
  return [
    `// ${generatedBanner(data.source)}`,
    "",
    "/** The lexer ID of each @pierre/highlights language name and alias. 0 is plain text. */",
    "export const HIGHLIGHTS_LANGUAGE_IDS = {",
    ...languages,
    "} as const satisfies Readonly<Record<string, number>>;",
    "",
    `/** \`[color, fontStyle]\` by token ID, from ${THEMES.light} and ${THEMES.dark}. fontStyle bits: italic 1, bold 2. */`,
    "export const HIGHLIGHTS_THEME_STYLES = {",
    "  light: [",
    ...styles("light"),
    "  ],",
    "  dark: [",
    ...styles("dark"),
    "  ],",
    '} as const satisfies Readonly<Record<"light" | "dark", ReadonlyArray<readonly [string, number]>>>;',
    "",
  ].join("\n");
}

// The lexers ask the host whether a non-ASCII code point can start or continue
// an identifier. These are the classes the JavaScript glue tests with regexes.
function renderIdRanges(): string {
  const classes = [
    ["id_start", /^\p{ID_Start}$/u],
    ["id_continue", /^[‌‍\p{ID_Continue}]$/u],
  ] as const;
  let out = `/* Generated by apps/mobile/scripts/generate-highlights.mts. Unicode ${process.versions.unicode} identifier classes. Do not edit. */\n`;
  for (const [name, pattern] of classes) {
    const ranges: Array<[number, number]> = [];
    let start = -1;
    for (let codePoint = 0; codePoint <= 0x110000; codePoint += 1) {
      const member =
        codePoint < 0x110000 &&
        (codePoint < 0xd800 || codePoint > 0xdfff) &&
        pattern.test(String.fromCodePoint(codePoint));
      if (member && start < 0) start = codePoint;
      if (!member && start >= 0) {
        ranges.push([start, codePoint - 1]);
        start = -1;
      }
    }
    out += `static const uint32_t ${name}_ranges[][2] = {\n`;
    for (let index = 0; index < ranges.length; index += 4) {
      const row = ranges.slice(index, index + 4);
      out += `  ${row.map(([from, to]) => `{0x${from.toString(16)}, 0x${to.toString(16)}}`).join(", ")},\n`;
    }
    out += "};\n";
  }
  return out;
}

function resolveWasm2c(): Wasm2c {
  const binary = process.env.WASM2C ?? "wasm2c";
  const version = execFileSync(binary, ["--version"], { encoding: "utf8" }).trim();
  if (version !== WASM2C_VERSION) {
    throw new Error(`Expected wasm2c ${WASM2C_VERSION}, found ${version}. Set WASM2C.`);
  }
  const resolved = realpathSync(
    isAbsolute(binary) ? binary : execFileSync("which", [binary], { encoding: "utf8" }).trim(),
  );
  return { binary, prefix: resolve(dirname(resolved), "..") };
}

function readSimdeHeader(): string {
  const root = process.env.SIMDE;
  if (!root) throw new Error("Set SIMDE to the extracted simde-amalgamated-0.8.2 folder.");
  const header = readFileSync(join(root, "wasm/simd128.h"), "utf8");
  if (header.split("\n", 2)[1] !== `/* ${SIMDE_COMMIT} */`) {
    throw new Error(`Expected simde ${SIMDE_COMMIT} (v0.8.2) in ${root}.`);
  }
  return header;
}

async function generate(): Promise<void> {
  if (process.versions.unicode !== UNICODE_VERSION) {
    throw new Error(`Expected Unicode ${UNICODE_VERSION}, found ${process.versions.unicode}. Run with Node 25.`);
  }
  const source = resolveHighlightsPackage();
  const wasm2c = resolveWasm2c();
  const simde = readSimdeHeader();
  const vendor = join(moduleRoot, "Vendor");

  const scratch = mkdtempSync(join(tmpdir(), "solus-highlights-"));
  try {
    execFileSync(wasm2c.binary, [
      join(source.root, "dist/highlights.wasm"),
      "-n",
      "highlights",
      "-o",
      join(scratch, "highlights.c"),
    ]);
    const banner = `/* ${generatedBanner(source)} */\n`;
    for (const file of ["highlights.c", "highlights.h"]) {
      writeFileSync(join(vendor, "highlights", file), banner + readFileSync(join(scratch, file), "utf8"));
    }
  } finally {
    rmSync(scratch, { recursive: true, force: true });
  }
  // The generated C is a translation of the package's Apache-2.0 WebAssembly.
  for (const file of ["LICENSE.md", "NOTICE.md"]) {
    copyFileSync(join(source.root, file), join(vendor, "highlights", file));
  }

  // The runtime must come from the same wabt release as the generated code.
  const runtime = [
    ["include/wasm-rt.h", "wasm-rt.h"],
    ["share/wabt/wasm2c/wasm-rt-impl.h", "wasm-rt-impl.h"],
    ["share/wabt/wasm2c/wasm-rt-impl.c", "wasm-rt-impl.c"],
    ["share/wabt/wasm2c/wasm-rt-impl-tableops.inc", "wasm-rt-impl-tableops.inc"],
    ["share/wabt/wasm2c/wasm-rt-mem-impl.c", "wasm-rt-mem-impl.c"],
    ["share/wabt/wasm2c/wasm-rt-mem-impl-helper.inc", "wasm-rt-mem-impl-helper.inc"],
  ] as const;
  for (const [from, to] of runtime) {
    copyFileSync(join(wasm2c.prefix, from), join(vendor, "wasm2c", to));
  }
  // The generated C includes <simde/wasm/simd128.h> for the module's SIMD ops.
  writeFileSync(join(vendor, "simde/wasm/simd128.h"), simde);

  writeFileSync(join(moduleRoot, "cpp/generated/id_ranges.inc"), renderIdRanges());
  writeFileSync(generatedDataPath, renderHighlightsData(await computeHighlightsData()));
}

if (import.meta.main) {
  await generate();
}
