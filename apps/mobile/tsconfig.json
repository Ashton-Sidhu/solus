{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@pierre/diffs/types": ["../../node_modules/@pierre/diffs/dist/types.d.ts"],
