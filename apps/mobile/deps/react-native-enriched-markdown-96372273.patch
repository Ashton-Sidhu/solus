                    }];
 }
+- (void)copyPngToPasteboard
+{
+  ENRMTableIOSGridView *grid = (ENRMTableIOSGridView *)_gridContainer;
+  UIPasteboard *pasteboard = UIPasteboard.generalPasteboard;
+  NSData *png = pasteboard ? [grid tablePngData] : nil;
+  if (png.length > 0) {
+    [pasteboard setItems:@[ @{ @"public.png" : png } ]];
+    return;
+  }
+
+  UIAlertController *alert =
+      [UIAlertController alertControllerWithTitle:NSLocalizedString(@"Could not copy the table.", nil)
+                                          message:nil
+                                   preferredStyle:UIAlertControllerStyleAlert];
+  [alert addAction:[UIAlertAction actionWithTitle:NSLocalizedString(@"OK", nil)
+                                            style:UIAlertActionStyleDefault
+                                          handler:nil]];
+  [RCTPresentedViewController() presentViewController:alert animated:YES completion:nil];
+}
 #endif // !TARGET_OS_OSX

 - (void)copyMarkdownToPasteboard
