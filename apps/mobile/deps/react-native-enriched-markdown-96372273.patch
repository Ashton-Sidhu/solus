         val plainText = rows.joinToString("\n") { row -> row.joinToString("\t") { it.plainText } }
@@ -411,10 +420,59 @@ class TableContainerView(
       item(ContextMenuPopup.Icon.DOCUMENT, dynamicProps.copyAsMarkdownLabel) {
         if (tableMarkdown.isNotEmpty()) clipboard.setPrimaryClip(ClipData.newPlainText("Table", tableMarkdown))
       }
+      val authority = "${context.packageName}.EnrichedMarkdownTablePngProvider"
+      if (context.packageManager.resolveContentProvider(authority, 0) != null) {
+        item(ContextMenuPopup.Icon.COPY, context.getString(R.string.enrm_copy_table_png)) {
+          copyTablePng(clipboard, authority)
+        }
+      }
     }
     return true
   }

+  private fun copyTablePng(clipboard: ClipboardManager, authority: String) {
+    val grid = gridContainer
+    val width = grid.width
+    val height = grid.height
+    var png: File? = null
+    try {
+      check(width > 0 && height > 0 && rows.isNotEmpty())
+      val scale = minOf(1.0, sqrt(4_194_304.0 / (width.toDouble() * height)), 8192.0 / maxOf(width, height))
+      val directory = File(context.cacheDir, "enrm-table-png")
+      if (!directory.isDirectory && !directory.mkdirs()) throw IOException("Table image cache unavailable")
+      val output = File.createTempFile("table-", ".png", directory)
+      png = output
+      val bitmap = Bitmap.createBitmap(
+        ceil(width * scale).toInt(),
+        ceil(height * scale).toInt(),
+        Bitmap.Config.ARGB_8888,
+      )
+      try {
+        val canvas = Canvas(bitmap)
+        val textColor = ColorUtils.setAlphaComponent(tableStyle.color, 255)
+        canvas.drawColor(if (ColorUtils.calculateLuminance(textColor) > 0.5) 0xff121212.toInt() else Color.WHITE)
+        canvas.scale(scale.toFloat(), scale.toFloat())
+        // Draw the complete grid without the horizontal scroll view's clip.
+        grid.draw(canvas)
+        output.outputStream().use { stream ->
+          if (!bitmap.compress(Bitmap.CompressFormat.PNG, 100, stream)) throw IOException("Table image encode failed")
+        }
+      } finally {
+        bitmap.recycle()
+      }
+      val uri = FileProvider.getUriForFile(context, authority, output)
+      clipboard.setPrimaryClip(ClipData.newUri(context.contentResolver, "Table", uri))
+      png = null // The clipboard needs this file until it is replaced.
+      directory.listFiles()?.filter { it != output }?.forEach { it.delete() }
+    } catch (_: IOException) {
+      Toast.makeText(context, R.string.enrm_copy_table_failed, Toast.LENGTH_SHORT).show()
+    } catch (_: RuntimeException) {
+      Toast.makeText(context, R.string.enrm_copy_table_failed, Toast.LENGTH_SHORT).show()
+    } finally {
+      png?.delete()
+    }
+  }
+
   private fun buildMarkdownFromRows(): String =
     rows.joinToString("") { row ->
       val line = "| ${row.joinToString(" | ") { it.markdownText }} |\n"
