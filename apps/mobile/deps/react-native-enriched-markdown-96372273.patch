@@ -80,6 +80,42 @@ - (void)fadeInRowsFrom:(NSUInteger)startRow duration:(NSTimeInterval)duration
 #pragma mark - Drawing

 - (void)drawRect:(CGRect)dirtyRect
+{
+  [self drawTableGridWithBlendMode:kCGBlendModeCopy];
+}
+
+- (NSData *)tablePngData
+{
+  CGSize size = self.bounds.size;
+  if (!isfinite(size.width) || !isfinite(size.height) || size.width <= 0 || size.height <= 0 ||
+      _tableRows.count == 0)
+    return nil;
+
+  // Bound the bitmap and reduce the scale when the table is larger.
+  CGFloat scale = MIN(MAX(self.traitCollection.displayScale, 1), 3);
+  scale = MIN(scale, sqrt(4194304.0 / (size.width * size.height)));
+  scale = MIN(scale, 8192.0 / MAX(size.width, size.height));
+  UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat preferredFormat];
+  format.scale = 1;
+  format.opaque = YES;
+  format.preferredRange = UIGraphicsImageRendererFormatRangeStandard;
+  CGSize pixelSize = CGSizeMake(ceil(size.width * scale), ceil(size.height * scale));
+  UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:pixelSize format:format];
+
+  // Draw the grid itself, so the ancestor scroll view cannot crop any columns.
+  return [renderer PNGDataWithActions:^(UIGraphicsImageRendererContext *context) {
+    UIColor *background = [UIColor.systemBackgroundColor resolvedColorWithTraitCollection:self.traitCollection];
+    [background setFill];
+    [context fillRect:(CGRect){CGPointZero, pixelSize}];
+    CGContextScaleCTM(context.CGContext, scale, scale);
+    if (self->_cornerRadius > 0) {
+      [[UIBezierPath bezierPathWithRoundedRect:self.bounds cornerRadius:self->_cornerRadius] addClip];
+    }
+    [self drawTableGridWithBlendMode:kCGBlendModeNormal];
+  }];
+}
+
+- (void)drawTableGridWithBlendMode:(CGBlendMode)blendMode
 {
   if (!_tableRows.count || !_columnWidths.count || !_rowHeights.count)
     return;
@@ -96,7 +132,7 @@ - (void)drawRect:(CGRect)dirtyRect
       CGRect cellRect = CGRectMake(xOffset, yOffset, columnWidth + _borderWidth, rowHeight + _borderWidth);

       [rowData.backgroundColor setFill];
-      UIRectFill(cellRect);
+      UIRectFillUsingBlendMode(cellRect, blendMode);

       [_borderColor setStroke];
       UIBezierPath *border = [UIBezierPath bezierPathWithRect:cellRect];
