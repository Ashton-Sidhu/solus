{
  "expo": {
    "name": "Solus",
    "slug": "solus",
    "scheme": "solus",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "../../resources/icon.png",
    "ios": {
      "icon": "./assets/icon-ios.png",
      "bundleIdentifier": "sh.solus.mobile",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Solus uses the camera only to scan a host's pairing code.",
        "NSLocalNetworkUsageDescription": "Solus connects to Solus hosts on your local network."
      }
    },
    "android": {
      "package": "sh.solus.mobile",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "@expo-google-fonts/dm-sans/400Regular/DMSans_400Regular.ttf",
              "@expo-google-fonts/dm-sans/500Medium/DMSans_500Medium.ttf",
              "@expo-google-fonts/dm-sans/600SemiBold/DMSans_600SemiBold.ttf",
              "@expo-google-fonts/dm-sans/700Bold/DMSans_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "DMSans-Regular",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/dm-sans/400Regular/DMSans_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "DMSans-Medium",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/dm-sans/500Medium/DMSans_500Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "DMSans-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/dm-sans/600SemiBold/DMSans_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "DMSans-Bold",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/dm-sans/700Bold/DMSans_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Solus uses the camera only to scan a host's pairing code.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Solus opens your photo library only when you attach a photo or video.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
